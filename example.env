# Copy this file to .env and update the values as needed
# cp example.env .env


# --- Configs ---
# Luna Backend Configuration
# REQUIRED: Luna proxies all API requests to Augur backend
# In Docker: use service name (e.g., augur:8000)
# In Kubernetes: use service DNS (e.g., augur-service.default.svc.cluster.local:8000)
LUNA_AUGUR_HOST=http://django-web-1:8000


# Protomaps vector basemap key (https://protomaps.com/account). Public: it ships to the browser,
# so restrict it to your domains in the Protomaps dashboard. Unset = keyless CARTO dark raster.
PUBLIC_PROTOMAPS_KEY=
